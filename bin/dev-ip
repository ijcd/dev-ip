#!/usr/bin/env bash
# dev-ip — one loopback IP + hostname per workspace/branch, resolved via a
# dedicated user dnsmasq. Imperative shell: composes lib/dev-ip-lib.sh (the
# pure core) and performs IO. See docs/dev-ip-plan.md.
set -euo pipefail

DEVIP_LIB="${DEVIP_LIB:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)/dev-ip-lib.sh}"
# shellcheck source=../lib/dev-ip-lib.sh
source "$DEVIP_LIB"

load_config   # populate DEVIP_* from the config file (env still wins)

# --- host-layer seams (paths overridable in tests) -------------------------
: "${DEVIP_RESOLVER_DIR:=/etc/resolver}"
: "${DEVIP_LAUNCHAGENTS:=$HOME/Library/LaunchAgents}"
: "${DEVIP_LAUNCHDAEMONS:=/Library/LaunchDaemons}"
: "${DEVIP_PF_CONF:=/etc/pf.conf}"
: "${DEVIP_PF_ANCHOR_FILE:=/etc/pf.anchors/dev-ip}"

CHECK=0            # 1 = dry-run (detect + print, never mutate)

# _run DESC CMD... -> in --check, print intent only; else log to DEVIP_CALL_LOG and run.
_run() {
  local desc="$1"; shift
  if [ "$CHECK" -eq 1 ]; then
    printf '  would: %s\n' "$desc"
    return 0
  fi
  printf '%s\n' "$*" >> "${DEVIP_CALL_LOG:-/dev/null}"
  "$@"
}

step_loopback() {   # step 2 — loopback aliases via a root LaunchDaemon
  local plist="$DEVIP_LAUNCHDAEMONS/dev-ip-loopback.plist" desired
  if [ "$(_resolve_owner "${DEVIP_LOOPBACK_OWNER:-dev-ip}")" = system ]; then
    printf 'loopback: system-owned (loopback_owner=system), skip\n'; return 0
  fi
  desired="$(render_loopback_plist)"
  if [ -f "$plist" ] && printf '%s\n' "$desired" | cmp -s - "$plist"; then
    printf 'loopback: daemon up to date\n'; return 0
  fi
  _run "mkdir -p $DEVIP_LAUNCHDAEMONS" mkdir -p "$DEVIP_LAUNCHDAEMONS"
  if [ "$CHECK" -eq 1 ]; then printf '  would: write %s + load daemon\n' "$plist"; return 0; fi
  printf '%s\n' "write $plist" >> "${DEVIP_CALL_LOG:-/dev/null}"
  printf '%s\n' "$desired" | sudo tee "$plist" >/dev/null
  _run "launchctl bootout system $plist" launchctl bootout system "$plist" 2>/dev/null || true
  _run "launchctl bootstrap system $plist" sudo launchctl bootstrap system "$plist"
}

step_pf() {   # step 3 — per-IP hairpin NAT anchor
  local anchor="$DEVIP_PF_ANCHOR_FILE" desired changed=0
  if [ "$(_resolve_owner "${DEVIP_PF_OWNER:-dev-ip}")" = system ]; then
    printf 'pf: system-owned (pf_owner=system), skip\n'; return 0
  fi
  desired="$(render_pf_anchor)"
  if [ "$CHECK" -eq 1 ]; then printf '  would: write %s + load pf anchor\n' "$anchor"; return 0; fi
  if ! { [ -f "$anchor" ] && printf '%s\n' "$desired" | cmp -s - "$anchor"; }; then
    _run "mkdir -p $(dirname "$anchor")" mkdir -p "$(dirname "$anchor")"
    printf '%s\n' "write $anchor" >> "${DEVIP_CALL_LOG:-/dev/null}"
    printf '%s\n' "$desired" | sudo tee "$anchor" >/dev/null
    changed=1
  fi
  if ! grep -qE '^(nat-anchor|load anchor) "dev-ip"' "$DEVIP_PF_CONF" 2>/dev/null; then
    printf '%s\n' "append pf.conf include" >> "${DEVIP_CALL_LOG:-/dev/null}"
    printf 'nat-anchor "dev-ip"\nload anchor "dev-ip" from "%s"\n' "$anchor" | sudo tee -a "$DEVIP_PF_CONF" >/dev/null
    changed=1
  fi
  if [ "$changed" -eq 0 ]; then printf 'pf: anchor + pf.conf up to date\n'; return 0; fi
  _run "pfctl -f $DEVIP_PF_CONF" sudo pfctl -f "$DEVIP_PF_CONF"
  _run "pfctl -e" sudo pfctl -e 2>/dev/null || true
}

step_dnsmasq_bin() {   # step 4
  if command -v dnsmasq >/dev/null 2>&1; then
    printf 'dnsmasq: found (%s)\n' "$(command -v dnsmasq)"
    return 0
  fi
  printf 'dnsmasq: MISSING — run `brew install dnsmasq`\n' >&2
  return 1
}

step_dnsmasq_agent() {   # step 5
  local bin plist desired
  bin="$(command -v dnsmasq 2>/dev/null || echo /opt/homebrew/bin/dnsmasq)"
  plist="$DEVIP_LAUNCHAGENTS/dev-ip-dnsmasq.plist"
  desired="$(render_dnsmasq_plist "$bin" "$(_hosts_dir)")"

  if [ -f "$plist" ] && printf '%s\n' "$desired" | cmp -s - "$plist" \
     && launchctl print "gui/$(id -u)/dev-ip-dnsmasq" >/dev/null 2>&1; then
    printf 'dnsmasq agent: running, config current\n'
    return 0
  fi
  _run "mkdir -p $DEVIP_LAUNCHAGENTS" mkdir -p "$DEVIP_LAUNCHAGENTS"
  if [ "$CHECK" -eq 1 ]; then
    printf '  would: write %s + reload agent\n' "$plist"
    return 0
  fi
  printf '%s\n' "write $plist" >> "${DEVIP_CALL_LOG:-/dev/null}"
  printf '%s\n' "$desired" > "$plist"
  _run "launchctl bootout gui/$(id -u)/dev-ip-dnsmasq" \
    launchctl bootout "gui/$(id -u)/dev-ip-dnsmasq" 2>/dev/null || true
  _run "launchctl bootstrap gui/$(id -u) $plist" \
    launchctl bootstrap "gui/$(id -u)" "$plist"
}

step_hostsd() {     # step 7
  local d; d="$(_hosts_dir)"
  if [ -d "$d" ]; then
    printf 'hosts.d: present\n'
  else
    _run "mkdir -p $d" mkdir -p "$d"
  fi
}

step_resolver() {   # step 6 (the one always-sudo bit)
  local dir="$DEVIP_RESOLVER_DIR" file="$DEVIP_RESOLVER_DIR/${DEVIP_TLD:-devip}"
  if [ -f "$file" ] && printf '%s\n' "$(render_resolver)" | cmp -s - "$file"; then
    printf 'resolver: %s up to date\n' "$file"
    return 0
  fi
  _run "mkdir -p $dir" mkdir -p "$dir"
  if [ "$CHECK" -eq 1 ]; then
    printf '  would: write %s\n' "$file"
    return 0
  fi
  printf 'sudo tee %s\n' "$file" >> "${DEVIP_CALL_LOG:-/dev/null}"
  render_resolver | sudo tee "$file" >/dev/null
}

# --- doctor probes (behavior) ---------------------------------------------
_probe_route() {   # IP -> ok | bind-fail | connect-fail
  local ip="$1"
  if [ -n "${DEVIP_STUB_ROUTE:-}" ]; then printf '%s\n' "$DEVIP_STUB_ROUTE"; return 0; fi
  perl -MIO::Socket::INET -e '
    my $ip = $ARGV[0];
    my $s = IO::Socket::INET->new(LocalAddr=>$ip, LocalPort=>0, Listen=>1, Proto=>"tcp", ReuseAddr=>1);
    unless ($s) { print "bind-fail\n"; exit 0 }
    my $c = IO::Socket::INET->new(PeerAddr=>$ip, PeerPort=>$s->sockport, Proto=>"tcp", Timeout=>2);
    print $c ? "ok\n" : "connect-fail\n";
  ' "$ip" 2>/dev/null || printf 'bind-fail\n'
}

_resolves_dnsmasq() {   # FQDN IP -> 0 if dnsmasq(:5354) answers with IP
  [ "$(dig +short @127.0.0.1 -p 5354 "$1" 2>/dev/null | head -1)" = "$2" ]
}

_resolves_system() {    # FQDN IP -> 0 if the system resolver answers with IP
  dscacheutil -q host -a name "$1" 2>/dev/null | grep -q "ip_address: $2"
}

# --- doctor presence checks (which fix to show) ---------------------------
_pf_loaded() {   # pf enabled AND a loopback hairpin in the main ruleset or ANY
  # anchor — owner-agnostic (dev-ip's own, nix's loopback_dev, a hand-rolled
  # one). pf reads need root; sudo caches after the first call. macOS pf does
  # not recurse anchors, so enumerate them (`-s Anchors`) and query each.
  local _a
  sudo pfctl -s info 2>/dev/null | grep -q 'Status: Enabled' || return 1
  { sudo pfctl -s nat 2>/dev/null
    sudo pfctl -s Anchors 2>/dev/null | while read -r _a; do
      [ -n "$_a" ] && sudo pfctl -a "$_a" -s nat 2>/dev/null
    done
  } | grep -q 'nat on lo0 .* -> 127\.0\.0\.1'
}
_agent_running() { launchctl print "gui/$(id -u)/dev-ip-dnsmasq" >/dev/null 2>&1; }

step_verify() {   # step 8 — always live (even under doctor/--check)
  local ip got fqdn
  fqdn="$(sanitize_name probe).${DEVIP_TLD:-devip}"
  ip="$(alloc_ip probe)"
  got="$(dig +short @127.0.0.1 -p 5354 "$fqdn" 2>/dev/null | head -1)"
  free_name probe
  if [ "$got" = "$ip" ]; then
    printf 'resolve probe: OK (%s -> %s)\n' "$fqdn" "$ip"
    return 0
  fi
  printf 'resolve probe: FAIL (%s -> %s, expected %s)\n' "$fqdn" "${got:-<none>}" "$ip" >&2
  return 1
}

do_provision() {
  step_loopback
  step_pf
  step_dnsmasq_bin
  step_dnsmasq_agent
  step_hostsd
  step_resolver
  [ "$CHECK" -eq 1 ] || step_verify
}

do_deprovision() {
  local agent="$DEVIP_LAUNCHAGENTS/dev-ip-dnsmasq.plist"
  local daemon="$DEVIP_LAUNCHDAEMONS/dev-ip-loopback.plist"

  # dnsmasq user agent
  launchctl bootout "gui/$(id -u)/dev-ip-dnsmasq" 2>/dev/null || true
  rm -f "$agent"

  # resolver (sudo)
  [ -f "$DEVIP_RESOLVER_DIR/${DEVIP_TLD:-devip}" ] && sudo rm -f "$DEVIP_RESOLVER_DIR/${DEVIP_TLD:-devip}"

  # pf anchor — only what dev-ip added (its include line + anchor file)
  if grep -qE '^(nat-anchor|load anchor) "dev-ip"' "$DEVIP_PF_CONF" 2>/dev/null; then
    grep -vE '^(nat-anchor|load anchor) "dev-ip"' "$DEVIP_PF_CONF" > "$DEVIP_PF_CONF.tmp" || true
    sudo mv "$DEVIP_PF_CONF.tmp" "$DEVIP_PF_CONF"
    sudo pfctl -f "$DEVIP_PF_CONF" 2>/dev/null || true
  fi
  [ -f "$DEVIP_PF_ANCHOR_FILE" ] && sudo rm -f "$DEVIP_PF_ANCHOR_FILE"

  # loopback daemon — only if dev-ip installed it (a system-owned one is a different label/path)
  if [ -f "$daemon" ]; then
    launchctl bootout system "$daemon" 2>/dev/null || true
    sudo rm -f "$daemon"
  fi
  printf 'deprovision: dev-ip host changes removed\n'
}

_config_src() {   # KEY -> env|config|default from DEVIP_CONFIG_SOURCES
  case " $DEVIP_CONFIG_SOURCES " in
    *" $1=env "*)    printf 'env\n' ;;
    *" $1=config "*) printf 'config\n' ;;
    *)               printf 'default\n' ;;
  esac
}

_config_show() {
  local cfg; cfg="$(_config_path)"
  local key env def desc val kw=3 vw=5
  # pass 1 — widest key and value, so columns don't go ragged on long paths
  while IFS='|' read -r key env def desc; do
    [ -n "$key" ] || continue
    val="$(printenv "$env" 2>/dev/null || printf '%s' "$def")"
    [ "${#key}" -gt "$kw" ] && kw=${#key}
    [ "${#val}" -gt "$vw" ] && vw=${#val}
  done <<EOF
$(_config_keys)
EOF
  printf '# %-*s   %-*s  source     what it does\n' "$kw" "key" "$vw" "value"
  # pass 2 — aligned rows
  while IFS='|' read -r key env def desc; do
    [ -n "$key" ] || continue
    val="$(printenv "$env" 2>/dev/null || printf '%s' "$def")"
    printf '%-*s = %-*s  %-9s # %s\n' "$kw" "$key" "$vw" "$val" "($(_config_src "$key"))" "$desc"
  done <<EOF
$(_config_keys)
EOF
  # warn on unknown keys in the file
  if [ -f "$cfg" ]; then
    local k
    for k in $(parse_config "$cfg" | sed 's/=.*//'); do
      _config_known_key "$k" || printf 'warning: unknown config key in %s: %s\n' "$cfg" "$k" >&2
    done
    printf 'config: %s (exists)\n' "$cfg"
  else
    printf 'config: %s (not created)\n' "$cfg"
  fi
}

do_config() {
  local sub="${1:-}"; [ "$#" -gt 0 ] && shift
  case "$sub" in
    "")   _config_show ;;
    get)  _config_get "${1:?dev-ip: config get: key required}" ;;
    set)  _config_set "${1:?dev-ip: config set: key required}" "${2:?dev-ip: config set: value required}" ;;
    edit) _config_edit ;;
    *)    echo "dev-ip: unknown config subcommand: $sub" >&2; return 2 ;;
  esac
}

_config_get() {
  local key="$1" k env def desc
  _config_known_key "$key" || { echo "dev-ip: unknown config key: $key" >&2; return 1; }
  while IFS='|' read -r k env def desc; do
    if [ "$k" = "$key" ]; then printenv "$env" 2>/dev/null || printf '%s\n' "$def"; return 0; fi
  done <<EOF
$(_config_keys)
EOF
}

_config_set() {
  local key="$1" val="$2" cfg
  _config_validate "$key" "$val" || return 1
  cfg="$(_config_path)"
  mkdir -p "$(dirname "$cfg")"
  { cat "$cfg" 2>/dev/null || true; } | render_config_upsert "$key" "$val" > "$cfg.tmp" && mv "$cfg.tmp" "$cfg"
}

_config_edit() {
  local cfg; cfg="$(_config_path)"
  if [ ! -s "$cfg" ]; then
    mkdir -p "$(dirname "$cfg")"
    render_config_template > "$cfg"
  fi
  exec "${EDITOR:-vi}" "$cfg"
}

_ck() {   # _ck ok|fail LABEL [REASON]
  if [ "$1" = ok ]; then printf '  ✓ %s\n' "$2"
  else printf '  ✗ %s — %s\n' "$2" "$3"; fi
}

_fix_diff() {   # FILE RENDERED  -> unified diff of on-disk (or empty) vs desired
  local cur="$1"; [ -f "$cur" ] || cur=/dev/null
  printf '      %s:\n' "$1"
  diff -u "$cur" <(printf '%s\n' "$2") 2>/dev/null | sed -n '3,$p' | sed 's/^/      /' || true
}

# _fix_* COMPONENT: in fix mode (fix=1) apply via the step (respecting
# loopback_owner/pf_owner) and return 0 (resolved); else print the fix and
# return 1 (unresolved — nothing gets applied in report mode). system-owned
# components stay unresolved even in fix mode. Called only from a ✗ branch of
# do_doctor.
_fix_resolver() { local fix="$1"
  if [ "$fix" -eq 1 ]; then step_resolver >/dev/null; printf '      → applied\n'; return 0; fi
  _fix_diff "$DEVIP_RESOLVER_DIR/${DEVIP_TLD:-devip}" "$(render_resolver)"
  return 1
}
_fix_agent() { local fix="$1"
  if [ "$fix" -eq 1 ]; then step_dnsmasq_agent >/dev/null; printf '      → applied\n'; return 0; fi
  printf '      fix: install/reload dev-ip-dnsmasq LaunchAgent (:5354)\n'
  return 1
}
_fix_loopback() { local fix="$1"
  if [ "$(_resolve_owner "${DEVIP_LOOPBACK_OWNER:-dev-ip}")" = system ]; then
    printf '      loopback_owner=system — provide these aliases yourself, or set loopback_owner=dev-ip\n'; return 1
  fi
  if [ "$fix" -eq 1 ]; then step_loopback >/dev/null; printf '      → applied\n'; return 0; fi
  _fix_diff "$DEVIP_LAUNCHDAEMONS/dev-ip-loopback.plist" "$(render_loopback_plist)"
  return 1
}
_fix_pf() { local fix="$1"
  if [ "$(_resolve_owner "${DEVIP_PF_OWNER:-dev-ip}")" = system ]; then
    printf '      pf_owner=system — hairpin owned by your system, or set pf_owner=dev-ip\n'; return 1
  fi
  if [ "$fix" -eq 1 ]; then step_pf >/dev/null; printf '      → applied\n'; return 0; fi
  _fix_diff "$DEVIP_PF_ANCHOR_FILE" "$(render_pf_anchor)"
  printf '      then: sudo pfctl -f %s && sudo pfctl -e\n' "$DEVIP_PF_CONF"
  return 1
}

# _routing_advisory ROUTE -> hint when the range is already routed by something
# other than dev-ip, yet loopback_owner is (default) dev-ip — i.e. dev-ip would
# install a redundant second manager. Fires only when the aliases are up but
# dev-ip's own loopback daemon is absent.
_routing_advisory() {
  [ "$1" = ok ] || return 0
  [ "$(_resolve_owner "${DEVIP_LOOPBACK_OWNER:-dev-ip}")" = dev-ip ] || return 0
  [ -f "$DEVIP_LAUNCHDAEMONS/dev-ip-loopback.plist" ] && return 0
  printf '  note: this range is already aliased, but not by dev-ip — looks system-managed.\n'
  printf '        set loopback_owner=system + pf_owner=system to defer, or run\n'
  printf '        `dev-ip provision` to let dev-ip manage it (a second daemon + anchor).\n'
}

do_doctor() {
  local fix=0; [ "${1:-}" = "--fix" ] && fix=1
  local tld="${DEVIP_TLD:-devip}" probe="__doctor_probe" label ip fqdn fails=0 unresolved=0
  ip="$(alloc_ip "$probe")" || { echo "dev-ip: doctor probe alloc failed" >&2; return 1; }
  # alloc_ip/free_name sanitize the name into a DNS label internally (see
  # sanitize_name in lib/dev-ip-lib.sh) -- the hosts.d entry is keyed by that
  # sanitized label, not the raw arg, so the probe FQDN must use it too or the
  # dig/dscacheutil lookups below miss.
  label="$(sanitize_name "$probe")"
  fqdn="$label.$tld"

  # unresolved = ✗ components --fix did NOT resolve: system-owner-deferred, connect-fail,
  # and (report mode only, since nothing gets applied) every ✗.
  printf 'Routing:\n'
  local route; route="$(_probe_route "$ip")"
  case "$route" in
    ok)           _ck ok "reachability ($ip) — alias up, natively reachable" ;;
    bind-fail)    _ck fail "reachability" "$ip not on lo0"; fails=$((fails+1))
                  _fix_loopback "$fix" || unresolved=$((unresolved+1)) ;;
    connect-fail) _ck fail "reachability" "$ip bound but connect blocked"; fails=$((fails+1))
                  printf '      something is blocking loopback connect — check a local firewall / pf ruleset\n'
                  unresolved=$((unresolved+1)) ;;
  esac
  sudo -n true 2>/dev/null || printf '  (reading the pf ruleset needs root — sudo will prompt)\n'
  if _pf_loaded; then _ck ok "pf hairpin loaded (required for Docker/cross-IP)"
  else _ck fail "pf hairpin" "no loopback hairpin loaded (or pf disabled)"; fails=$((fails+1))
       _fix_pf "$fix" || unresolved=$((unresolved+1)); fi
  _routing_advisory "$route"

  printf 'Resolution:\n'
  if _resolves_dnsmasq "$fqdn" "$ip"; then _ck ok "dnsmasq (:5354) answering"
  elif _agent_running; then _ck fail "dnsmasq (:5354)" "agent running but no answer for $fqdn"; fails=$((fails+1))
       _fix_agent "$fix" || unresolved=$((unresolved+1))
  else _ck fail "dnsmasq (:5354)" "agent not running"; fails=$((fails+1))
       _fix_agent "$fix" || unresolved=$((unresolved+1)); fi
  if _resolves_system "$fqdn" "$ip"; then _ck ok "system resolver routes .$tld"
  else _ck fail "system resolver" ".$tld not routed to :5354"; fails=$((fails+1))
       _fix_resolver "$fix" || unresolved=$((unresolved+1)); fi

  free_name "$probe"
  if [ "$fails" -eq 0 ]; then printf 'all checks passed\n'
  elif [ "$fix" -eq 0 ]; then printf '→ run `dev-ip doctor --fix` to apply the fixes dev-ip owns\n'; fi
  if [ "$fix" -eq 1 ]; then [ "$unresolved" -eq 0 ]; else [ "$fails" -eq 0 ]; fi
}

usage() {
  cat >&2 <<'EOF'
usage: dev-ip <command> [args]

  ip <name>      allocate (if needed) and print the loopback IP for <name>
  alloc <name>   alias for `ip`
  free <name>    release <name>'s allocation
  ls             list allocations
  provision      converge host resolver/loopback/pf/dnsmasq   (sudo: resolver)
  doctor         provision --check + an end-to-end resolve probe
  deprovision    remove dev-ip's host changes
  config                print effective config + source per key
  config get <key>      print one resolved value
  config set <key> <v>  set a value in the config file
  config edit           open the config file in $EDITOR (seeded if empty)
EOF
}

main() {
  local cmd="${1:-}"
  [ "$#" -gt 0 ] && shift
  case "$cmd" in
    ip | alloc | provision | doctor) _pool_bounds >/dev/null || return 1 ;;
  esac
  case "$cmd" in
    ip | alloc)  alloc_ip "${1:?dev-ip: name required}" ;;
    free)        free_name "${1:?dev-ip: name required}" ;;
    ls)          list_allocations ;;
    provision)
      [ "${1:-}" = "--check" ] && CHECK=1
      do_provision ;;
    doctor)      do_doctor "$@" ;;
    deprovision) do_deprovision ;;
    config)      do_config "$@" ;;
    -h | --help) usage; return 0 ;;
    "")          usage; return 2 ;;
    *)           echo "dev-ip: unknown command: $cmd" >&2; usage; return 2 ;;
  esac
}

# run main only when executed, not when sourced (lets tests source the funcs)
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  main "$@"
fi
