#!/usr/bin/env bash
printf 'pfctl %s\n' "$*" >> "${DEVIP_CALL_LOG:-/dev/null}"
# `pfctl -a loopback_dev -s nat` shows nix rules only when the stub says so.
case "$*" in
  *"-a loopback_dev -s nat"*)
    [ -n "${DEVIP_STUB_NIX_PF:-}" ] && echo "nat on lo0 from 127.0.0.10 to 127.0.0.10 -> 127.0.0.1"
    ;;
esac
case "$*" in
  "-s info")            [ -n "${DEVIP_STUB_PF_ENABLED:-}" ] && echo "Status: Enabled" || echo "Status: Disabled" ;;
  "-a dev-ip -s nat")   [ -n "${DEVIP_STUB_PF_LOADED:-}" ] && echo "nat on lo0 from 127.0.0.10 to 127.0.0.10 -> 127.0.0.1" ;;
esac
exit 0
