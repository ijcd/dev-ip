#!/usr/bin/env bash
printf 'ifconfig %s\n' "$*" >> "${DEVIP_CALL_LOG:-/dev/null}"
# `ifconfig lo0` listing: print aliases only if the stub says they exist.
if [ "$1" = "lo0" ] && [ "$#" -eq 1 ]; then
  echo "lo0: flags=8049<UP,LOOPBACK,RUNNING,MULTICAST>"
  echo "	inet 127.0.0.1 netmask 0xff000000"
  if [ -n "${DEVIP_STUB_LOOPBACK_PRESENT:-}" ]; then
    for o in $(seq 10 99); do echo "	inet 127.0.0.$o netmask 0xffffffff"; done
  fi
fi
exit 0
